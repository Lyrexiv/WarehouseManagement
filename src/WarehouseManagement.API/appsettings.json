{
  "ConnectionStrings": {
    "DefaultConnection": "Server=...;User Id=...;Password=..."
  },
  "Jwt": {
    "Key": "YOUR_REAL_SECRET_KEY",
    "Issuer": "WarehouseManagement.API",
    "Audience": "WarehouseManagement.Client",
    "ExpiryHours": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/wms-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "http://localhost:5173" ]
  }
}
